<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>NoIntro</AssemblyName>
    <!-- The game folder. Override with: dotnet build -p:GameDir="D:\path\to\Just Shapes & Beats" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Just Shapes &amp; Beats</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  <!-- Goes in BepInEx\mods so Sun Loader can load it. -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(Deploy)' != 'false' And Exists('$(GameDir)\BepInEx')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\mods" />
  </Target>
</Project>
